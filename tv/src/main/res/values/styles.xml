<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.SendTV" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowBackground">#080D19</item>
    <item name="android:colorAccent">#60A5FA</item>
    <item name="android:textColorPrimary">#F8FAFC</item>
    <item name="android:textColorSecondary">#A8BCD6</item>
    <item name="android:windowFullscreen">true</item>
  </style>
  <style name="TvText">
    <item name="android:textColor">#A8BCD6</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">20sp</item>
    <item name="android:layout_marginBottom">16dp</item>
  </style>
  <style name="TvButton" parent="android:style/Widget.Material.Button">
    <item name="android:focusableInTouchMode">true</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">64dp</item>
    <item name="android:minWidth">200dp</item>
    <item name="android:padding">16dp</item>
    <item name="android:layout_marginEnd">24dp</item>
    <item name="android:background">@drawable/action_background</item>
    <item name="android:textColor">#F8FAFC</item>
    <item name="android:textSize">20sp</item>
  </style>
</resources>
