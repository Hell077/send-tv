---
import "../styles/site.css";
import { href } from "../lib/navigation";
interface Props {
    title: string;
    description?: string;
}
const {
    title,
    description = "SendTV: a local-network URL handoff project for Android TV. V1 is under verification; no accounts or cloud relay.",
} = Astro.props;
const canonical = Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const github = __GITHUB_URL__;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="referrer" content="no-referrer" />
        <meta property="og:title" content={`${title} · SendTV`} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="SendTV" />
        {canonical && <link rel="canonical" href={canonical} />}
        {canonical && <meta property="og:url" content={canonical} />}
        <title>{title} · SendTV</title>
    </head>
    <body>
        <a class="skip" href="#main">
            Skip to content
        </a>
        <header class="site-header">
            <a class="wordmark" href={href("")}>
                SendTV
            </a>
            <nav class="desktop-nav" aria-label="Primary">
                <a href={href("#features")}>Features</a>
                <a href={href("#how-it-works")}>How it works</a>
                <a href={href("docs/getting-started/")}>Docs</a>
                {github && <a href={github}>GitHub ↗</a>}
            </nav>
            <details class="mobile-nav">
                <summary>Menu</summary>
                <nav aria-label="Mobile primary">
                    <a href={href("#features")}>Features</a>
                    <a href={href("#how-it-works")}>How it works</a>
                    <a href={href("docs/getting-started/")}>Docs</a>
                    {github && <a href={github}>GitHub ↗</a>}
                </nav>
            </details>
        </header>
        <slot />
        <footer class="site-footer">
            <p>
                Android / Google TV first. An installed receiver and compatible
                URL handler are required.
            </p>
            <nav aria-label="Footer">
                <a href={href("privacy/")}>Privacy</a>
                <a href={href("changelog/")}>Changelog</a>
                <a href={href("docs/faq/")}>FAQ</a>
            </nav>
            <p class="muted">
                V1 development preview. No verified public APK release yet.
            </p>
        </footer>
    </body>
</html>
