---
import Base from "./Base.astro";
import { guides, href as baseHref } from "../lib/navigation";
interface Props {
    frontmatter: {
        title: string;
        description?: string;
        toc?: { id: string; label: string }[];
    };
}
const { frontmatter } = Astro.props;
const ru = Astro.url.pathname.startsWith(`${import.meta.env.BASE_URL}ru/`);
const t = (en: string, russian: string) => (ru ? russian : en);
const href = (path: string) => baseHref(`${ru ? "ru/" : ""}${path}`);
const labels = [
    "Начало работы",
    "Устранение неполадок",
    "Архитектура и конфиденциальность",
    "API приёмника",
    "Вопросы и ответы",
    "CLI: планируется в V2",
];
---

<Base title={frontmatter.title} description={frontmatter.description}>
    <div class="docs-shell">
        <aside class="docs-nav">
            <details open>
                <summary>{t("Documentation", "Документация")}</summary>
                <label for="guide-search">
                    {t("Find a guide", "Найти руководство")}
                </label>
                <input
                    id="guide-search"
                    type="search"
                    placeholder={t("Filter guides", "Фильтр руководств")}
                />
                <nav aria-label={t("Documentation", "Документация")}>
                    {guides.map(([slug, label], index) => (
                        <a
                            data-doc-link
                            href={href(`docs/${slug}/`)}
                            aria-current={
                                Astro.url.pathname.endsWith(`/docs/${slug}/`)
                                    ? "page"
                                    : undefined
                            }
                        >
                            {ru ? labels[index] : label}
                        </a>
                    ))}
                </nav>
            </details>
        </aside>
        <main id="main" class="prose" tabindex="-1">
            <p class="eyebrow">
                {t("V1 · DEVELOPMENT PREVIEW", "V1 · ПРЕДВАРИТЕЛЬНАЯ ВЕРСИЯ")}
            </p>
            <h1>{frontmatter.title}</h1>
            <p class="muted">
                {t("Last updated", "Обновлено")}{" "}
                <time datetime="2026-11-05">
                    {t("5 November 2026", "5 ноября 2026")}
                </time>
            </p>
            <slot />
        </main>
        {frontmatter.toc && (
            <aside class="page-toc">
                <nav aria-label={t("On this page", "На этой странице")}>
                    <strong>{t("On this page", "На этой странице")}</strong>
                    {frontmatter.toc.map(({ id, label }) => (
                        <a href={`#${id}`}>{label}</a>
                    ))}
                </nav>
            </aside>
        )}
    </div>
</Base>
<script>
    const search = document.querySelector<HTMLInputElement>("#guide-search");
    search?.addEventListener("input", () => {
        const query = search.value.toLowerCase();
        document
            .querySelectorAll<HTMLAnchorElement>("[data-doc-link]")
            .forEach((link) => {
                link.hidden = !link.textContent?.toLowerCase().includes(query);
            });
    });
    const ru = document.documentElement.lang === "ru";
    document.querySelectorAll("pre").forEach((pre) => {
        const button = document.createElement("button");
        button.textContent = ru ? "Копировать код" : "Copy code";
        button.type = "button";
        button.addEventListener("click", () => {
            void navigator.clipboard
                .writeText(pre.querySelector("code")?.textContent ?? "")
                .then(() => {
                    button.textContent = ru ? "Скопировано" : "Copied";
                })
                .catch(() => {
                    button.textContent = ru
                        ? "Выделите код для копирования"
                        : "Select code to copy";
                });
        });
        pre.after(button);
    });
</script>
